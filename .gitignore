.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath


# IntelliJ
.idea/
*.iml
out/

# Gradle
.gradle/
build/

# Java
*.class
hs_err_pid*
replay_pid*

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.local
*.secret
secrets/
*.pem
*.key

# Docker
docker-data/

# Testing / coverage
coverage/
reports/

# Node (in case later tools use it)
node_modules/

# Temporary files
tmp/
temp/
*.swp
*.swo

# LocalStack / local generated files
.localstack/
# Ignore Gradle build output directory
build
